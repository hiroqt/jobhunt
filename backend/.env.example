# Server
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database (Default: SQLite async; for PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/job_hunt_pipeline)
DATABASE_URL=sqlite+aiosqlite:///./job_hunt.db

# Default AI Provider (Options: fallback, nvidia, glm, groq, gemini, openai, ollama)
DEFAULT_AI_PROVIDER=fallback

# 1. Google Gemini (Gemini 2.5 Flash / 1.5 Pro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. NVIDIA NIM (Free tier API keys e.g. Llama 3.3 70B, DeepSeek R1)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# 3. Zhipu AI / GLM (Free/Low-cost GLM-4-Flash)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# 4. Groq (Fast Free Tier Llama 3.3)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 5. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 6. Local Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
