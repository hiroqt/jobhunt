# Server
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database (Default: SQLite async; for PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/job_hunt_pipeline)
DATABASE_URL=sqlite+aiosqlite:///./job_hunt.db

# Default AI Provider (Options: openrouter, nemotron-light, nvidia, glm, groq, gemini, fallback)
DEFAULT_AI_PROVIDER=openrouter

# Rate Limiting (Requests per minute per client)
AI_RATE_LIMIT_PER_MINUTE=20

# 1. OpenRouter — Nemotron 3 Ultra (Free Tier)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# 2. OpenRouter — Nemotron 3.5 Lightning (Free Tier)
OPENROUTER_LIGHT_API_KEY=
OPENROUTER_LIGHT_MODEL=nvidia/nemotron-3.5-lightning:free

# 3. Google Gemini (Gemini 2.5 Flash Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 4. NVIDIA NIM (Free tier API keys e.g. Llama 3.3 70B, DeepSeek R1)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# 5. Zhipu AI / GLM (Free GLM-4-Flash)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# 6. Groq (Fast Free Tier Llama 3.3)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
